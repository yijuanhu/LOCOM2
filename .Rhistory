# loading data
library(LOCOM2)
data("throat.otu.table.filter")
data("throat.meta.filter")
data("throat.otu.taxonomy")
Y <- ifelse(throat.meta.filter$SmokingStatus == "NonSmoker", 0, 1)
C <- ifelse(throat.meta.filter$Sex == "Male", 0, 1)
# running locom2
res <- locom2(formula = throat.otu.table.filter | C ~ Y, seed = 1)
length(res$p.otu.Wald) # 193
length(res$detected.otu.Wald) # 4
res$detected.otu.Wald
## "1371" "1280" "4363" "1490"
res$p.otu.Wald[res$detected.otu.Wald]
#1371         1280         4363         1490
#1.065265e-03 6.154699e-05 4.187447e-07 1.221012e-03
res$p.global # 0.006993007
# running locom2
res <- locom2(formula = throat.otu.table.filter | C + C1 ~ Y, seed = 1)
C1 <- throat.meta.filter$Age
# running locom2
res <- locom2(formula = throat.otu.table.filter | C + C1 ~ Y, seed = 1)
length(res$p.otu.Wald) # 193
length(res$detected.otu.Wald) # 4
res$detected.otu.Wald
## "1371" "1280" "4363" "1490"
res$p.otu.Wald[res$detected.otu.Wald]
#1371         1280         4363         1490
#1.065265e-03 6.154699e-05 4.187447e-07 1.221012e-03
res$p.global # 0.006993007
