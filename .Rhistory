library(survival)
data(cancer)
force(lung)
surv_obj <- Surv(time = lung$time, event = lung$status == 2)
?surv
?Surv
fit_KM <- survfit(surv_obj ~ 1)
summary(fit_KM)
plot(fit_KM, xlab = "Time", ylab = "Survival Probability", main = "Kaplan-Meier Estimate")
?survfit
lung[1:4,]
fit_KM <- survfit(surv_obj ~ lung$sex)
summary(fit_KM)
plot(fit_KM, xlab = "Time", ylab = "Survival Probability", main = "Kaplan-Meier Estimate")
fit_KM <- survfit(surv_obj ~ 1)
summary(fit_KM)
fit_gender <- survfit(surv_obj ~ sex, data = lung)
plot(fit_gender, col = c("blue", "red"), lty = 1, xlab = "Time (days)", ylab = "Survival Probability",
main = "Kaplan-Meier Survival Curves by Gender")
legend("topright", legend = c("Male", "Female"), col = c("blue", "red"), lty = 1)
survdiff(surv_obj ~ sex, data = lung)
